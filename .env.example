# Vorlage für /opt/xera-ai/.env — die echte Datei gehört nie ins Repo (chmod 600).

# Discord-Anmeldung (https://discord.com/developers/applications)
DISCORD_CLIENT_ID=deine-client-id
DISCORD_CLIENT_SECRET=dein-client-secret
DISCORD_REDIRECT_URI=https://example.org/auth/callback
# Bot im eigenen Server — liest die Rollen nach (backend/rollen.py), braucht keine Rechte
DISCORD_BOT_TOKEN=dein-bot-token
XERA_GUILD_ID=
XERA_ROLLE_PRO=
XERA_ROLLE_ADMIN=
XERA_ROLLE_HOMELAB=

# Sitzungs-Cookie signieren: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

# Dienste im eigenen Netz
LLAMA_API_URL=http://127.0.0.1:8080
SEARXNG_URL=http://127.0.0.1:8888
SEARXNG_ABSENDER=127.0.0.1
GRAFANA_URL=http://127.0.0.1:3000
GRAFANA_TOKEN=
PROMETHEUS_URL=http://127.0.0.1:9090
COUCHDB_URL=http://127.0.0.1:5984
COUCHDB_USER=
COUCHDB_PASS=

# Netze, die nie gesperrt werden (mit Komma), z. B. eigenes LAN und VPN
XERA_INTERN_NETZE=
# Discord-IDs, die im Wartungsmodus hinein dürfen (mit Komma)
WARTUNG_ZUGANG=
# SSH-Ziele und Netz-Beschreibungen — Vorlage: standort.example.json
XERA_STANDORT=/opt/xera-ai/privat/standort.json
# OpenCode-Programm für den Code-Bereich
XERA_OPENCODE=/opt/xera-ai/motor/opencode
